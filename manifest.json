{
  "manifest_version": 3,
  "name": "Cotacol on Strava Route Builder",
  "version": "1.0.0",
  "description": "Shows all 1000 Cotacol climbs on the Strava Route Builder map, green if you've done them, orange if not, synced from your cotacol.cc account.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.strava.com/*",
    "https://www.cotacol.cc/*",
    "https://cotacol.cc/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cotacol on Strava"
  },
  "web_accessible_resources": [
    {
      "resources": ["data/climbs.json"],
      "matches": ["https://*.strava.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.cotacol.cc/*",
        "https://cotacol.cc/*"
      ],
      "js": [
        "cotacol-sync.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.strava.com/maps/*",
        "https://www.strava.com/routes/*",
        "https://*.strava.com/maps/*",
        "https://*.strava.com/routes/*"
      ],
      "js": [
        "map-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.strava.com/maps/*",
        "https://www.strava.com/routes/*",
        "https://*.strava.com/maps/*",
        "https://*.strava.com/routes/*"
      ],
      "js": [
        "overlay-content.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icons/icon128.png"
  }
}
